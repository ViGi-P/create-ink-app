{
  "name": "library-js",
  "version": "0.1.0",
  "description": "Ink powered library",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "babel --out-dir=dist src",
    "dev": "babel --out-dir=dist --watch src",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "ink-testing-library": "^4.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "babel": {
    "plugins": [
      "./babel-plugin-rewrite-esm-imports.cjs"
    ],
    "presets": [
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    ]
  }
}
