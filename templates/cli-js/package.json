{
  "name": "cli-js",
  "version": "0.1.0",
  "description": "Hello world Ink CLI",
  "type": "module",
  "bin": "./dist/cli.js",
  "scripts": {
    "build": "babel --out-dir=dist src",
    "dev": "babel --out-dir=dist --watch src",
    "lint": "xo",
    "pretest": "babel --out-dir=dist src",
    "test": "node --test dist/__tests__/*.test.js dist/__tests__/**/*.test.js"
  },
  "dependencies": {
    "@endernoke/wax": "^1.0.0",
    "ink": "^7.0.2",
    "meow": "^14.1.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "eslint-config-xo-react": "^0.27.0",
    "ink-testing-library": "^4.0.0",
    "xo": "^0.60.0"
  },
  "xo": {
    "space": 2,
    "prettier": true,
    "extends": [
      "xo-react"
    ],
    "react": true,
    "rules": {
      "react/prop-types": "off",
      "react/react-in-jsx-scope": "off"
    }
  },
  "babel": {
    "plugins": [
      "./babel-plugin-rewrite-esm-imports.cjs"
    ],
    "presets": [
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    ]
  }
}
