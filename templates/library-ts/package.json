{
  "name": "lib-ts",
  "version": "0.1.0",
  "description": "Ink powered library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "xo src",
    "pretest": "tsc",
    "test": "node --test dist/__tests__/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "xo": "^0.60.0"
  },
  "xo": {
    "prettier": true,
    "typescript": true,
    "rules": {
      "@typescript-eslint/naming-convention": "off",
      "n/file-extension-in-import": "off"
    }
  }
}
